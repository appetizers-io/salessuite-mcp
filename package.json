{
  "name": "salessuite-mcp",
  "version": "0.1.0",
  "description": "MCP server for the SalesSuite CRM API (contacts, deals, notes, calls, emails, webhooks). Only needs an API key.",
  "type": "module",
  "bin": {
    "salessuite-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "SALESSUITE_LIVE_TEST=1 vitest run test/live.test.ts",
    "update-spec": "tsx scripts/update-spec.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "generate": "openapi-ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "salessuite",
    "crm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appetizers-io/salessuite-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
